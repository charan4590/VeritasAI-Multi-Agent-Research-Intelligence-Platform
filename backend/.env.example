# ============================================================
# Research Agent — Environment Configuration
# ============================================================

# --- Search (REQUIRED) ---
# Free key: https://tavily.com
TAVILY_API_KEY=

# --- AI Model (choose ONE) ---
# Option A: Ollama local (free, offline, no quota)
OLLAMA_MODEL=llama3.2
# For better quality: ollama pull llama3.1:8b  then set:
# OLLAMA_MODEL=llama3.1:8b

# Option B: Groq cloud (free tier, faster)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# --- Phase 1: RAG ---
EMBED_MODEL=nomic-embed-text
CHROMA_PATH=../data/chroma_db
CHUNK_SIZE=300
CHUNK_OVERLAP=50
RAG_TOP_K=8
# Run: ollama pull nomic-embed-text

# --- Phase 3 Milestone 2: PDF Agent ---
# How many chunks PDFAgent retrieves per search query (see agent/agents/pdf_agent.py)
PDF_CHUNKS_PER_QUERY=3

# --- Phase 2: Observability ---
# Optional: send traces to LangSmith
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=research-agent

# --- Phase 4: Memory ---
MEMORY_TOP_K=2
MEMORY_THRESHOLD=0.75

# --- Milestone 3: Caching ---
# Uses diskcache (persistent, on disk) if installed; otherwise falls back
# automatically to an in-memory cache for the life of the process.
CACHE_ENABLED=true
CACHE_BACKEND=auto
CACHE_DIR=../data/cache
SEARCH_CACHE_TTL=1800
FETCH_CACHE_TTL=86400
EMBED_CACHE_TTL=604800

# --- Phase 6: Auth ---
# Set AUTH_ENABLED=true to require login
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-random-secret-run-openssl-rand-hex-32
DEFAULT_ADMIN_PASSWORD=admin123
TOKEN_EXPIRE_HOURS=24

# --- Storage ---
DB_PATH=../data/research.db
