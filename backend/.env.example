# ============================================================
# Research Agent — Environment Configuration
# ============================================================

# --- Search (REQUIRED — at least one of these two) ---
# Tavily: free tier is 1,000 queries/month, no auto mid-cycle refill.
#TAVILY_API_KEY=your_tavily_api_key_here

# Serper.dev: automatic fallback when Tavily fails (quota/invalid key/
# network). Free: 2,500 queries, no credit card required — https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# auto = try Tavily then Serper; "serper" or "tavily" forces one.
SEARCH_PROVIDER=auto

# --- AI Model (choose ONE) ---
# Option A: Ollama local (free, offline, no quota)
OLLAMA_MODEL=llama3.2
# Default assumes Ollama running on the same host. Change to
# http://ollama:11434 when using docker-compose's optional `ollama`
# service (see docker-compose.yml) -- "localhost" inside a container
# means the container itself, not the host or a sibling service.
OLLAMA_BASE_URL=http://localhost:11434
# For better quality: ollama pull llama3.1:8b  then set:
# OLLAMA_MODEL=llama3.1:8b

# Option B: Groq cloud (free tier, faster)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Option C: Google Gemini (free, 1500 requests/day)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Phase 1: RAG ---
EMBED_MODEL=nomic-embed-text
CHROMA_PATH=../data/chroma_db
CHUNK_SIZE=300
CHUNK_OVERLAP=50
RAG_TOP_K=8
# Run: ollama pull nomic-embed-text

# --- Phase 3 Milestone 2: PDF Agent ---
# How many chunks PDFAgent retrieves per search query (see agent/agents/pdf_agent.py)
PDF_CHUNKS_PER_QUERY=3

# --- Phase 3 Milestone 3: Fact Verification Agent ---
# Caps the number of (sentence, citation) claims verified per report,
# bounding the size/cost of the single batched verification LLM call.
MAX_CLAIMS_TO_VERIFY=15
# TTL for cached (claim, source_text) -> verdict pairs.
VERIFICATION_CACHE_TTL=604800

# --- Phase 2: Observability ---
# Optional: send traces to LangSmith
# LANGSMITH_API_KEY=ls__...
# LANGSMITH_PROJECT=research-agent

# --- Phase 4: Memory ---
MEMORY_TOP_K=2
MEMORY_THRESHOLD=0.75

# --- Milestone 3: Caching ---
# Uses diskcache (persistent, on disk) if installed; otherwise falls back
# automatically to an in-memory cache for the life of the process.
CACHE_ENABLED=true
CACHE_BACKEND=auto
CACHE_DIR=../data/cache
SEARCH_CACHE_TTL=1800
FETCH_CACHE_TTL=86400
EMBED_CACHE_TTL=604800

# --- Phase 6: Auth ---
# Set AUTH_ENABLED=true to require login
AUTH_ENABLED=true
JWT_SECRET=generate_your_own_with_openssl_rand_hex_32
DEFAULT_ADMIN_PASSWORD=change_this_default_password
TOKEN_EXPIRE_HOURS=24

# --- Storage ---
DB_PATH=../data/research.db